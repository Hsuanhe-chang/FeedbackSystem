@model FeedbackSystem.Models.ViewModels.FeedbackTrackViewModel

@{
    ViewData["Title"] = "查詢意見進度";

    // ── 輔助函式：Status 轉中文與 Bootstrap badge class ──────────────────
    string GetStatusBadge(byte status) => status switch
    {
        0 => "bg-secondary",          // 待處理：灰色
        1 => "bg-primary",            // 處理中：藍色
        2 => "bg-success",            // 已回覆：綠色
        3 => "bg-dark",               // 已關閉：黑色
        _ => "bg-secondary"
    };

    string GetStatusText(byte status) => status switch
    {
        0 => "待處理",
        1 => "處理中",
        2 => "已回覆",
        3 => "已關閉",
        _ => "未知"
    };
}

<div class="row justify-content-center">
    <div class="col-md-8">

        <h2 class="mb-4">查詢意見進度</h2>
        <p class="text-muted mb-4">
            請輸入您提交意見時系統產生的追蹤代碼，即可查詢目前的處理狀態與官方回覆。
        </p>

        @* ════════════════════════════════════════════
           查詢表單
           ════════════════════════════════════════════ *@
        <div class="card mb-4">
            <div class="card-body">
                <form asp-controller="Feedback" asp-action="Track" method="post">

                    <div class="row g-3 align-items-end">
                        @* 追蹤代碼輸入欄 *@
                        <div class="col-md-8">
                            <label asp-for="TrackingCode" class="form-label fw-semibold">
                                追蹤代碼
                            </label>
                            <input asp-for="TrackingCode"
                                   class="form-control form-control-lg"
                                   placeholder="例如：FB20260504A3F9K2"
                                   autocomplete="off"
                                   style="text-transform: uppercase;" />
                            @* 欄位驗證錯誤訊息（空白送出時顯示） *@
                            <span asp-validation-for="TrackingCode" class="text-danger small"></span>
                        </div>

                        @* 查詢按鈕 *@
                        <div class="col-md-4">
                            <button type="submit" class="btn btn-primary btn-lg w-100">
                                🔍 查詢進度
                            </button>
                        </div>
                    </div>

                </form>
            </div>
        </div>

        @* ════════════════════════════════════════════
           找不到資料的提示（NotFound=true 時顯示）
           ════════════════════════════════════════════ *@
        @if (Model.NotFound)
        {
            <div class="alert alert-warning d-flex align-items-center" role="alert">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor"
                     class="bi bi-exclamation-triangle-fill me-2 flex-shrink-0" viewBox="0 0 16 16">
                    <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zm.018 9.184a1 1 0 0 1-2 0V8a1 1 0 0 1 2 0v2.75zm-1 3.25a1 1 0 1 1 0-2 1 1 0 0 1 0 2z"/>
                </svg>
                <div>
                    <strong>找不到意見記錄</strong> —
                    代碼「<code>@Model.TrackingCode</code>」不存在或輸入有誤，請確認後再試。
                </div>
            </div>
        }

        @* ════════════════════════════════════════════
           查詢結果：意見進度卡片（Result != null 時顯示）
           ════════════════════════════════════════════ *@
        @if (Model.Result != null)
        {
            var r = Model.Result;

            @* 意見基本資訊卡 *@
            <div class="card mb-4 border-0 shadow-sm">
                <div class="card-header d-flex justify-content-between align-items-center bg-light">
                    <strong>意見進度</strong>
                    @* 處理狀態 badge *@
                    <span class="badge @GetStatusBadge(r.Status) fs-6">
                        @GetStatusText(r.Status)
                    </span>
                </div>
                <div class="card-body">

                    @* 第一列：追蹤代碼 / 建立時間 *@
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <div class="text-muted small">追蹤代碼</div>
                            <code class="fs-6">@r.TrackingCode</code>
                        </div>
                        <div class="col-md-6">
                            <div class="text-muted small">提交時間</div>
                            <span>@r.CreatedAt.ToString("yyyy-MM-dd HH:mm")</span>
                        </div>
                    </div>

                    @* 第二列：客戶姓名 / 類別 *@
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <div class="text-muted small">客戶姓名</div>
                            <span>@r.CustomerName</span>
                        </div>
                        <div class="col-md-6">
                            <div class="text-muted small">意見類別</div>
                            <span>@r.Category</span>
                        </div>
                    </div>

                    @* 主旨 *@
                    <div class="mb-3">
                        <div class="text-muted small">意見主旨</div>
                        <strong>@r.Subject</strong>
                    </div>

                    @* 內容（pre-wrap 保留換行，Razor 預設 HTML Encode 防 XSS） *@
                    <div class="mb-3">
                        <div class="text-muted small">意見內容</div>
                        <div class="border rounded p-3 bg-light" style="white-space: pre-wrap;">@r.Content</div>
                    </div>

                    @* 回覆統計 *@
                    <div class="row">
                        <div class="col-md-6">
                            <div class="text-muted small">回覆總數</div>
                            <span>@r.ReplyCount 筆</span>
                        </div>
                        @if (r.LatestReplyAt.HasValue)
                        {
                            <div class="col-md-6">
                                <div class="text-muted small">最新回覆時間</div>
                                <span>@r.LatestReplyAt.Value.ToString("yyyy-MM-dd HH:mm")</span>
                            </div>
                        }
                    </div>
                </div>
            </div>

            @* ── 公開回覆串 ────────────────────────────────────────────────── *@
            <h5 class="mb-3">
                回覆記錄
                <span class="badge bg-secondary ms-1">@r.PublicReplies.Count 筆</span>
            </h5>

            @if (!r.PublicReplies.Any())
            {
                @* 尚無公開回覆時顯示提示 *@
                <div class="alert alert-light border text-center text-muted">
                    目前尚無回覆，我們將盡快處理您的意見，感謝您的耐心等候。
                </div>
            }
            else
            {
                @foreach (var reply in r.PublicReplies)
                {
                    @* ReplyType=1（官方回覆）靠右藍底；ReplyType=0（客戶回覆）靠左灰底 *@
                    bool isOfficial  = reply.ReplyType == 1;
                    string rowClass    = isOfficial ? "justify-content-end"  : "justify-content-start";
                    string bubbleClass = isOfficial ? "bg-primary bg-opacity-10 border-primary" : "bg-light";
                    string typeLabel   = isOfficial ? "官方回覆" : "客戶回覆";
                    string typeBadge   = isOfficial ? "bg-primary" : "bg-secondary";

                    <div class="d-flex @rowClass mb-3">
                        <div class="card border @bubbleClass" style="max-width: 80%;">
                            <div class="card-header py-1 d-flex justify-content-between align-items-center gap-3">
                                @* 回覆類型標籤 *@
                                <span class="badge @typeBadge">@typeLabel</span>
                                @* 回覆者與時間（右對齊） *@
                                <small class="text-muted">
                                    @reply.ReplierName &nbsp;｜&nbsp; @reply.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                                </small>
                            </div>
                            <div class="card-body py-2">
                                @* pre-wrap 保留換行格式，Razor 預設 HTML Encode 防 XSS *@
                                <p class="mb-0" style="white-space: pre-wrap;">@reply.Content</p>
                            </div>
                        </div>
                    </div>
                }
            }
        }

        @* ── 操作連結區 ────────────────────────────────────────────────── *@
        <div class="mt-4 d-flex gap-2">
            <a asp-controller="Feedback" asp-action="Create" class="btn btn-outline-success">
                ＋ 提交新意見
            </a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                返回首頁
            </a>
        </div>

    </div>
</div>

@section Scripts {
    @* 引入 jQuery Validation，確保 TrackingCode 空白送出時前端即時提示 *@
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
